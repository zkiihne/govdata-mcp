# GovData MCP — master credentials (server-held).
# Copy to .env and fill in. Tier 1.5 free connectors that need a key go here;
# Tier 2 premium connectors will read their secrets from here too.
# Never commit .env.

# Census Bureau API key — https://api.census.gov/data/key_signup.html (free)
CENSUS_API_KEY=

# Bureau of Labor Statistics v2 registration key — https://data.bls.gov/registrationEngine/ (free)
BLS_API_KEY=

# SEC EDGAR requires no key, but mandates a descriptive User-Agent on every request.
# Format: "AppName contact@example.com"
SEC_USER_AGENT=

# Premium / property-records connector keys (Tier 2 — placeholders for later)
PROPERTY_RECORDS_API_KEY=
