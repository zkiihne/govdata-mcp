# GovData MCP — master credentials (server-held).
# Copy to .env and fill in. Tier 1.5 free connectors that need a key go here;
# Tier 2 premium connectors will read their secrets from here too.
# Never commit .env.

# Census Bureau API key — https://api.census.gov/data/key_signup.html (free)
CENSUS_API_KEY=

# Bureau of Labor Statistics v2 registration key — https://data.bls.gov/registrationEngine/ (free)
BLS_API_KEY=

# SEC EDGAR requires no key, but mandates a descriptive User-Agent on every request.
# Format: "AppName contact@example.com"
SEC_USER_AGENT=

# FRED (Federal Reserve Economic Data) API key — https://fredaccount.stlouisfed.org/apikeys (free)
FRED_API_KEY=

# NOAA Climate Data Online (CDO) token — https://www.ncdc.noaa.gov/cdo-web/token (free)
NOAA_CDO_TOKEN=

# EPA AirNow API key — https://docs.airnowapi.org/account/request/ (free)
AIRNOW_API_KEY=

# --- Second-wave key-required sources (specs only; connectors land later) ---

# Congress.gov / api.data.gov key — https://api.congress.gov/sign-up/ (free)
CONGRESS_API_KEY=

# EIA Energy Data API key — https://www.eia.gov/opendata/register.php (free)
EIA_API_KEY=

# BEA (Bureau of Economic Analysis) UserID — https://apps.bea.gov/API/signup/ (free)
BEA_API_KEY=

# openFDA API key (optional; raises per-IP limits) — https://open.fda.gov/apis/authentication/ (free)
OPENFDA_API_KEY=

# NVD (NIST National Vulnerability Database) key (optional; raises rate limit) — https://nvd.nist.gov/developers/request-an-api-key (free)
NVD_API_KEY=

# Regulations.gov / api.data.gov key (premium-gated) — https://open.gsa.gov/api/regulationsgov/#getting-started
REGULATIONS_API_KEY=

# SAM.gov API key (premium-gated; requires a SAM.gov account) — https://sam.gov/profile/details
SAM_API_KEY=

# USGS Water Data API key (premium-gated; new OGC API, migration in progress) — https://api.waterdata.usgs.gov/signup/
USGS_WATER_API_KEY=

# Premium / property-records connector keys (Tier 2 — placeholders for later)
PROPERTY_RECORDS_API_KEY=
