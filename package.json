{
  "name": "govdata-mcp",
  "version": "0.1.0",
  "description": "MCP gateway giving agents access to government and public data through one proxy. Raw passthrough, LLM-optimized tool docs, server-held credentials.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "govdata-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "mcp-handler": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
